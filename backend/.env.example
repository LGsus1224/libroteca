# Copia este archivo a .env y completa los valores. NO subas .env a git.
PORT=3000
# Secreto para firmar los tokens JWT (si falta, se genera uno local en data/.secret)
JWT_SECRET=
# Opcional: clave gratuita de Google AI Studio. Sin ella el asistente responde con reglas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
